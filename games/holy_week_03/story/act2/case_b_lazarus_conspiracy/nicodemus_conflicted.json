                            "\n",
                            {
                                "#f": 5
                            }
                        ]
                    }
                ],
                {
                    "#f": 1
                }
            ],
            "closing": [
                [
                    "^I am trying to work from within, but the walls are closing in. At some point, one must choose between the scroll and the Light.",
                    "\n",
